#!/usr/bin/env python3

from gradelib import *

r = Runner(save("xv6.out"))

@test(0, "running seektest")
def test_seektest():
    r.run_qemu(shell_script([
        "seektest"
    ]), timeout=20)

@test(25, "seektest passes", parent=test_seektest)
def test_seektest_ok():
    r.match(r"^seek test: ok$")

@test(25, "usertests -q")
def test_usertests():
    r.run_qemu(shell_script([
        "usertests -q"
    ]), timeout=300)
    r.match(r"^ALL TESTS PASSED$")

run_tests()
